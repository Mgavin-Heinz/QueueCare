@model QueueCare.ViewModels.ClinicDayFormViewModel
@{
    bool isNew = Model.ClinicDayId == 0;
    ViewData["Title"] = isNew ? "Add clinic day" : "Edit clinic day";
}

<section class="qb-section">
    <div class="qb-main" style="max-width: 700px; margin: 0 auto;">
        
        <h1 class="qb-title"><span class="qb-title-ink">@(isNew ? "Add" : "Edit")</span> Clinic Day</h1>

        <form asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? (int?)null : Model.ClinicDayId)" method="post" class="qb-book-form">
            <div asp-validation-summary="ModelOnly" class="qb-validation"></div>
            <input type="hidden" asp-for="ClinicDayId" />

            @if (isNew)
            {
                <div class="qb-field">
                    <label for="ServiceId" class="qb-label">Service</label>
                    <select id="ServiceId" name="ServiceId" class="qb-input qb-select" asp-items="Model.Services">
                        <option value="">Choose a service...</option>
                    </select>
                    <span asp-validation-for="ServiceId" class="qb-validation"></span>
                </div>

                <div class="qb-field">
                    <label for="Date" class="qb-label">Date</label>
                    <input id="Date" name="Date" type="date" class="qb-input" value="@Model.Date?.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="Date" class="qb-validation"></span>
                </div>
            }
            else
            {
                <input type="hidden" asp-for="ServiceId" />
                
                <div class="qb-field">
                    <label class="qb-label">Service</label>
                    <input class="qb-input" value="@Model.ServiceName" readonly style="background-color: var(--qc-light); opacity: 0.8;" />
                </div>
                
                <div class="qb-field">
                    <label class="qb-label">Date</label>
                    <input class="qb-input" value="@Model.Date?.ToString("ddd d MMM yyyy")" readonly style="background-color: var(--qc-light); opacity: 0.8;" />
                    <small class="qb-hint">The date and service cannot be changed because appointments may already be booked for this day.</small>
                </div>
                
                <div class="qb-alert-success" style="background-color: #EFF6FF; border-color: #93C5FD; color: #1E40AF;">
                    @Model.Used patient(s) already booked or checked in for this day. The capacity cannot go below that number.
                </div>
            }

            <div class="qb-top" style="grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 20px;">
                <div class="qb-field" style="margin-bottom: 0;">
                    <label for="OpenTime" class="qb-label">Opening time</label>
                    <input id="OpenTime" name="OpenTime" type="time" class="qb-input" value="@Model.OpenTime?.ToString("HH:mm")" />
                    <span asp-validation-for="OpenTime" class="qb-validation"></span>
                </div>
                <div class="qb-field" style="margin-bottom: 0;">
                    <label for="CloseTime" class="qb-label">Closing time</label>
                    <input id="CloseTime" name="CloseTime" type="time" class="qb-input" value="@Model.CloseTime?.ToString("HH:mm")" />
                    <span asp-validation-for="CloseTime" class="qb-validation"></span>
                </div>
            </div>

            <div class="qb-field" style="margin-top: 20px;">
                <label for="Capacity" class="qb-label">Daily capacity (patients)</label>
                <input id="Capacity" name="Capacity" type="number" min="1" class="qb-input" value="@Model.Capacity" />
                <small class="qb-hint">Bookings and walk-ins share this number.</small>
                <span asp-validation-for="Capacity" class="qb-validation"></span>
            </div>

            <div class="qb-actions" style="flex-direction: row; margin-top: 30px;">
                <button type="submit" class="qb-btn qb-btn-confirm" style="width: auto; min-width: 150px;">Save</button>
                <a asp-action="Index" class="qb-btn qb-btn-ghost">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}