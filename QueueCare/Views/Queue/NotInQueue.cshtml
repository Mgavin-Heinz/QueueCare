@{
    ViewData["Title"] = "Live Queue";
}

<section class="qb-section">
    <div class="qb-main" style="max-width: 700px; margin: 0 auto; text-align: center;">
        <h1 class="qb-title"><span class="qb-title-ink">Live</span> Queue</h1>
        <div class="qb-table-wrapper" style="padding: 40px 24px;">
            <h2 style="margin-bottom: 12px;">You are not in the queue today</h2>
            <p style="color: var(--qc-slate); margin-bottom: 24px;">
                Check in at reception when you arrive and your place in the queue will show here.
            </p>
            <a asp-controller="Appointments" asp-action="Mine" class="qb-btn qb-btn-confirm" style="width: auto; padding: 12px 24px;">My appointments</a>
        </div>
    </div>
</section>