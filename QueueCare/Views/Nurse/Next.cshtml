@model QueueCare.Models.NurseDashboardViewModel
@{
    ViewData["Title"] = "Nurse View";
}

<section class="qn-page">
    <div class="qn-wrap">

        @if (TempData["Message"] is string message)
        {
            <div class="qn-toast" role="status">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                <span>@message</span>
            </div>
        }

        <h1 class="qn-title"><span class="qn-title-ink">Nurse</span> <span class="qn-title-slate">View</span></h1>

        @if (Model.CurrentPatient != null)
        {
            <!-- The Big Current Patient Card -->
            <div class="qn-current-card">
                <div class="qn-current-label">Now consulting</div>
                <div class="qn-current-ticket">@Model.CurrentPatient.TicketNumber</div>
                
                <div class="qn-current-details">
                    <div>
                        <span class="qn-label">Patient</span>
                        <strong>@Model.CurrentPatient.PatientName</strong>
                    </div>
                    <div>
                        <span class="qn-label">Service</span>
                        <strong>@Model.CurrentPatient.ServiceName</strong>
                    </div>
                </div>

                @if (Model.CurrentPatient.Status == "InConsultation")
                {
                    <form asp-action="Done" asp-route-id="@Model.CurrentPatient.QueueEntryId" method="post" class="qn-form">
                        <button type="submit" class="qn-btn-done">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                            Mark Consultation Done
                        </button>
                    </form>
                }
                else if (Model.CurrentPatient.Status == "Called")
                {
                    <form asp-action="Start" asp-route-id="@Model.CurrentPatient.QueueEntryId" method="post" class="qn-form">
                        <button type="submit" class="qn-btn-start">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3" /></svg>
                            Start Consultation
                        </button>
                    </form>
                }
            </div>
        }
        else
        {
            <div class="qn-empty-card">
                <h2>No patient currently in consultation.</h2>
                <p>Waiting for reception to call the next patient.</p>
            </div>
        }

        <!-- Upcoming List -->
        <div class="qn-upcoming">
            <h2 class="qn-section-title">Upcoming Patients <span class="qn-count">@Model.UpcomingPatients.Count</span></h2>
            
            @if (!Model.UpcomingPatients.Any())
            {
                <p class="qn-empty-text">Nobody else is waiting in the queue right now.</p>
            }
            else
            {
                <div class="qn-list">
                    @foreach (var item in Model.UpcomingPatients)
                    {
                        <div class="qn-list-item">
                            <strong class="qn-list-ticket">@item.TicketNumber</strong>
                            <div class="qn-list-details">
                                <span>@item.PatientName</span>
                                <small>@item.ServiceName</small>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

    </div>
</section>