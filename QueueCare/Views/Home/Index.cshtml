@{
    ViewData["Title"] = "Home";
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<!-- ============ HERO (about half a screen tall) ============ -->
<section class="qh-hero">
    <div class="qh-wrap qh-hero-grid">

        <div class="qh-hero-left">
            <div class="qh-hero-brand">
                <img src="~/images/logo_v1.png" alt="QueueCare logo" class="qh-hero-logo" />
                <span class="qh-chip">Live queue &middot; Online booking</span>
            </div>

            <h1 class="qh-hero-title">
                Skip the queue.<br />
                <span class="qh-hero-accent">Book online.</span>
            </h1>
            <p class="qh-hero-subtitle">
                Book clinic appointments and track your place in the live queue, from your phone, at home.
            </p>

            <div class="qh-hero-actions">
                @if (signedIn)
                {
                    <a asp-controller="Appointments" asp-action="Book" class="qh-btn qh-btn-primary">Book Appointment</a>
                    <a asp-controller="Queue" asp-action="Live" class="qh-btn qh-btn-secondary">Track My Queue</a>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Register" class="qh-btn qh-btn-primary">Get Started</a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="qh-btn qh-btn-secondary">Login</a>
                }
            </div>
        </div>

        <!-- Replace the <svg> with <img src="~/images/hero.png" alt="..." /> when you have a real image -->
        <div class="qh-hero-right">
            <div class="qh-hero-image">
                <svg viewBox="0 0 320 320" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Phone showing a live queue position">
                    <rect x="95" y="18" width="130" height="260" rx="22" fill="#1F2937" />
                    <rect x="105" y="40" width="110" height="216" rx="12" fill="#CBD4E2" />
                    <rect x="140" y="26" width="40" height="6" rx="3" fill="#4A6080" />
                    <text x="160" y="82" text-anchor="middle" font-size="11" font-weight="700" fill="#4A6080" font-family="system-ui, sans-serif">YOUR PLACE</text>
                    <text x="160" y="140" text-anchor="middle" font-size="56" font-weight="800" fill="#1F2937" font-family="system-ui, sans-serif">#3</text>
                    <circle cx="130" cy="175" r="8" fill="#4A6080" />
                    <circle cx="160" cy="175" r="8" fill="#4A6080" />
                    <circle cx="190" cy="175" r="8" fill="#4A6080" opacity="0.35" />
                    <rect x="120" y="205" width="80" height="26" rx="13" fill="#1F2937" />
                    <text x="160" y="222" text-anchor="middle" font-size="11" font-weight="700" fill="#FFFFFF" font-family="system-ui, sans-serif">I'm on my way</text>
                </svg>

                <span class="qh-float qh-float-a">~12 min wait</span>
                <span class="qh-float qh-float-b">Booked &#10003;</span>
            </div>
        </div>
    </div>
</section>

<!-- ============ HOW IT WORKS ============ -->
<section class="qh-section" id="how-it-works">
    <div class="qh-wrap">
        <div class="qh-section-head qh-reveal">
            <span class="qh-eyebrow">Three simple steps</span>
            <h2 class="qh-section-title">How it <span class="highlight">works</span></h2>
        </div>

        <div class="qh-steps">
            <article class="qh-step qh-step-1 qh-reveal">
                <span class="qh-step-num">01</span>
                <div class="qh-step-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                </div>
                <h3>Book online</h3>
                <p>Choose a service, date and time slot that suits you. No more arriving at dawn.</p>
            </article>

            <article class="qh-step qh-step-2 qh-reveal">
                <span class="qh-step-num">02</span>
                <div class="qh-step-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                </div>
                <h3>Track your place</h3>
                <p>See your position in the live queue and an estimated wait time, updated in real time.</p>
            </article>

            <article class="qh-step qh-step-3 qh-reveal">
                <span class="qh-step-num">03</span>
                <div class="qh-step-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5" /></svg>
                </div>
                <h3>Arrive on time</h3>
                <p>Skip the paper queue. Walk in when it's your turn and get seen faster.</p>
            </article>
        </div>
    </div>
</section>

<!-- ============ ABOUT US ============ -->
<section class="qh-section" id="about">
    <div class="qh-wrap qh-about">

        <div class="qh-about-visual qh-reveal" aria-hidden="true">
            <div class="qh-about-panel qh-about-panel-back"></div>
            <div class="qh-about-panel qh-about-panel-front">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z" /></svg>
            </div>
            <div class="qh-about-badge"><span>Care,<br />without<br />the wait</span></div>
        </div>

        <div class="qh-about-copy qh-reveal">
            <span class="qh-eyebrow">About us</span>
            <h2 class="qh-section-title">Healthcare shouldn't start with a long wait.</h2>
            <p>
                QueueCare helps clinics and patients make better use of their time. Patients book a slot
                and follow the queue live, while clinics get a clearer, calmer flow through the day.
            </p>

            <div class="qh-about-tiles">
                <div class="qh-tile"><strong>24/7</strong><span>Online booking</span></div>
                <div class="qh-tile"><strong>Live</strong><span>Queue updates</span></div>
                <div class="qh-tile"><strong>Zero</strong><span>Paper tickets</span></div>
            </div>
        </div>
    </div>
</section>

<!-- ============ WHO IT'S FOR ============ -->
<section class="qh-section">
    <div class="qh-wrap">
        <div class="qh-section-head qh-reveal">
            <span class="qh-eyebrow">Built for both sides</span>
            <h2 class="qh-section-title">Made for patients and clinics</h2>
        </div>

        <div class="qh-audience">
            <div class="qh-audience-card qh-reveal">
                <h3>For patients</h3>
                <ul>
                    <li>Book appointments from anywhere</li>
                    <li>See your place in the queue live</li>
                    <li>Manage and review your visits</li>
                </ul>
            </div>
            <div class="qh-audience-card qh-audience-dark qh-reveal">
                <h3>For clinics</h3>
                <ul>
                    <li>Fewer crowded waiting rooms</li>
                    <li>A clear view of the day's bookings</li>
                    <li>Smoother, more predictable flow</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- ============ SIGN-UP CTA ============ -->
<section class="qh-section">
    <div class="qh-wrap">
        <div class="qh-cta qh-reveal">
            <div>
                <h2>Ready to skip the queue?</h2>
                <p>Create your free account in under a minute and book your first appointment.</p>
            </div>
            @if (signedIn)
            {
                <a asp-controller="Appointments" asp-action="Book" class="qh-btn qh-btn-light">Book Appointment</a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Register" class="qh-btn qh-btn-light">Create Account</a>
            }
        </div>
    </div>
</section>

<!-- ============ FAQ ============ -->
<section class="qh-section qh-section-last" id="faq">
    <div class="qh-wrap qh-faq-wrap">
        <div class="qh-section-head qh-reveal">
            <span class="qh-eyebrow">Good to know</span>
            <h2 class="qh-section-title">Frequently asked questions</h2>
        </div>

        <div class="qh-faq qh-reveal">
            <details>
                <summary>How do I book an appointment?</summary>
                <p>Create an account, choose a service, then pick a date and time slot that suits you.</p>
            </details>
            <details>
                <summary>Can I see where I am in the queue?</summary>
                <p>Yes. Once you're booked in, you can follow your position and estimated wait live.</p>
            </details>
            <details>
                <summary>Do I need to create an account?</summary>
                <p>An account lets you book, track your place and manage your visits in one place.</p>
            </details>
            <details>
                <summary>Who do I contact if I need help?</summary>
                <p>Use the Customer Service link in the footer and we'll get back to you.</p>
            </details>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Gentle scroll-reveal
        (function () {
            var items = document.querySelectorAll('.qh-reveal');
            if (!('IntersectionObserver' in window)) return;
            document.documentElement.classList.add('qh-js');
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
                });
            }, { threshold: 0.12 });
            items.forEach(function (el) { io.observe(el); });
        })();
    </script>
}
