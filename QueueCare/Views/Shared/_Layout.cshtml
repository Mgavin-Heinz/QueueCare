<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QueueCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QueueCare.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="qc-header">
        <div class="d-flex align-items-center w-100">

            @* ---------- LEFT: LOGO + BRAND TEXT ---------- *@
            <a class="qc-brand" asp-controller="Home" asp-action="Index">
                <img src="~/images/logo_v1.png" alt="QueueCare logo" class="qc-logo" />
                <span class="qc-brand-text">
                    <span class="qc-brand-queue">Queue</span><span class="qc-brand-care">Care</span>
                </span>
            </a>

            @* ---------- RIGHT: GREETING + ICON NAV ---------- *@
            <div class="qc-nav-right">

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @* Username greeting *@
                    <span class="qc-user-greeting">
                        Hello <strong>@User.Identity.Name</strong>!
                    </span>

                    @* Home icon *@
                    <a class="qc-nav-link" asp-controller="Home" asp-action="Index" title="Home">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-4a2 2 0 0 0-2-2h0a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        </svg>
                        <span class="qc-nav-label">Home</span>
                    </a>

                    <div class="qc-nav-divider"></div>

                    @* Logout icon *@
                    <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="d-inline m-0">
                        <button type="submit" class="qc-nav-link" title="Logout">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                                <polyline points="16 17 21 12 16 7" />
                                <line x1="21" y1="12" x2="9" y2="12" />
                            </svg>
                            <span class="qc-nav-label">Logout</span>
                        </button>
                    </form>
                }
                else
                {
                    @* Home icon *@
                    <a class="qc-nav-link" asp-controller="Home" asp-action="Index" title="Home">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-4a2 2 0 0 0-2-2h0a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                        </svg>
                        <span class="qc-nav-label">Home</span>
                    </a>

                    <div class="qc-nav-divider"></div>

                    @* Register icon *@
                    <a class="qc-nav-link" asp-area="Identity" asp-page="/Account/Register" title="Register">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <line x1="19" y1="8" x2="19" y2="14" />
                            <line x1="22" y1="11" x2="16" y2="11" />
                        </svg>
                        <span class="qc-nav-label">Register</span>
                    </a>

                    <div class="qc-nav-divider"></div>

                    @* Login icon *@
                    <a class="qc-nav-link" asp-area="Identity" asp-page="/Account/Login" title="Login">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
                            <polyline points="10 17 15 12 10 7" />
                            <line x1="15" y1="12" x2="3" y2="12" />
                        </svg>
                        <span class="qc-nav-label">Login</span>
                    </a>
                }

            </div>
        </div>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - QueueCare - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
