<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - QueueCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body class="qc-auth-body">

    <!-- Minimal header: home icon only -->
    <header class="qc-header">
    <div class="d-flex align-items-center w-100">

        <!-- LEFT: logo + brand text -->
        <a class="qc-brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo_v1.png" alt="QueueCare logo" class="qc-logo" />
            <span class="qc-brand-text">
                <span class="qc-brand-queue">Queue</span><span class="qc-brand-care">Care</span>
            </span>
        </a>

        <!-- RIGHT: home icon only -->
        <div class="qc-nav-right">
            <a class="qc-nav-link" asp-controller="Home" asp-action="Index" title="Home">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2v-4a2 2 0 0 0-2-2h0a2 2 0 0 0-2 2v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                </svg>
                <span class="qc-nav-label">Home</span>
            </a>
        </div>

    </div>
</header>

    <main>
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="qc-footer">
        <div class="qc-footer-top">
            <img src="~/images/logo_v1.png" alt="QueueCare" class="qc-footer-logo" />
            <span class="qc-footer-brand">QueueCare</span>
        </div>
        <p class="qc-footer-tagline">
            Skip the waiting room. Book appointments and track your place in the live queue.
        </p>

        <!-- Dynamic island: headings only -->
        <div class="qc-footer-island">
            <h4>General</h4>
            <h4>Help</h4>
            <h4>Location</h4>
            <h4>Socials</h4>
        </div>

        <!-- Content sits under each heading -->
        <div class="qc-footer-columns">
            <ul>
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                <li><a asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                <li><a asp-area="Identity" asp-page="/Account/Login">Login</a></li>
            </ul>
            <ul>
                <li><a href="#">Customer Service</a></li>
                <li><a href="#">Legal</a></li>
            </ul>
            <div>
                <iframe class="qc-footer-map" title="QueueCare location — Bloemfontein" loading="lazy"
                    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d446147.6222073672!2d25.89356986006226!3d-29.119604233731266!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x1e8fc57b9f07bf8b%3A0x1f16f55bb211b749!2sBloemfontein!5e0!3m2!1sen!2sza!4v1791916465352!5m2!1sen!2sza"
                    allowfullscreen="" referrerpolicy="strict-origin-when-cross-origin"></iframe>
            </div>
            <div class="qc-footer-social">
                <a href="#" aria-label="Instagram">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" /><circle cx="12" cy="12" r="4" /><line x1="17.5" y1="6.5" x2="17.5" y2="6.5" /></svg>
                </a>
                <a href="#" aria-label="LinkedIn">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM0 8h5v16H0V8zm7.5 0h4.8v2.2h.07c.67-1.2 2.3-2.5 4.73-2.5 5.06 0 6 3.3 6 7.6V24h-5v-7.5c0-1.8-.03-4.1-2.5-4.1-2.5 0-2.9 1.96-2.9 4v7.6h-5V8z" /></svg>
                </a>
            </div>
        </div>

        <div class="qc-footer-bigbrand" aria-hidden="true">
            <span class="qc-footer-queue">Queue</span><span class="qc-footer-care">Care</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Fallback for browsers without cross-page View Transitions:
        // slide the pill, fade the card, then navigate.
        (function () {
            var slider = document.querySelector('.qc-auth-slider');
            if (!slider || 'CSSViewTransitionRule' in window) return;
            slider.querySelectorAll('a').forEach(function (a) {
                a.addEventListener('click', function (e) {
                    e.preventDefault();
                    if (a.classList.contains('active')) return;
                    slider.classList.toggle('is-login');
                    var card = document.querySelector('.qc-auth-card');
                    if (card) card.classList.add('is-leaving');
                    setTimeout(function () { window.location.href = a.href; }, 300);
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
