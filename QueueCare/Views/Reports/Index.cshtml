@model QueueCare.Models.ReportViewModel
@{
    ViewData["Title"] = "Reports";
}

<h1>Reports</h1>
<p>Last 7 days</p>

<div class="row">
    <div class="col-md-6">
        <h2>Average wait</h2>
        <p>@Model.AverageWaitMinutes.ToString("0.0") minutes</p>
    </div>
    <div class="col-md-6">
        <h2>No-show rate</h2>
        <p>@Model.NoShowRatePercent.ToString("0.0")%</p>
    </div>
</div>

<h2>Patients served per day</h2>
@if (Model.ServedPerDay.Any())
{
    <table class="table">
        <thead>
            <tr><th>Date</th><th>Patients served</th></tr>
        </thead>
        <tbody>
            @foreach (var day in Model.ServedPerDay)
            {
                <tr><td>@day.Date.ToString("ddd d MMM")</td><td>@day.Count</td></tr>
            }
        </tbody>
    </table>
}
else
{
    <p>No patients served in the last 7 days.</p>
}