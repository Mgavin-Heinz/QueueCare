@model QueueCare.Models.ReportViewModel
@{
    ViewData["Title"] = "Reports";
}

<section class="qb-section">
    <div class="qb-main" style="max-width: 900px; margin: 0 auto;">
        
        <h1 class="qb-title"><span class="qb-title-ink">Daily</span> Reports</h1>
        <p class="qb-hint" style="margin-bottom: 30px; font-size: 15px;">Last 7 days</p>

        <!-- Stat Cards -->
        <div class="qr-stats" style="grid-template-columns: 1fr 1fr; max-width: 600px;">
            <div class="qr-stat qr-stat-dark">
                <div class="qr-stat-text">
                    <span class="qr-stat-value">@Model.AverageWaitMinutes.ToString("0.0")</span>
                    <span class="qr-stat-label">Avg Wait (min)</span>
                </div>
            </div>
            <div class="qr-stat">
                <div class="qr-stat-text">
                    <span class="qr-stat-value">@Model.NoShowRatePercent.ToString("0.0")%</span>
                    <span class="qr-stat-label">No-show Rate</span>
                </div>
            </div>
        </div>

        <!-- Table -->
        <h2 class="qb-title" style="font-size: 24px; margin-top: 40px; margin-bottom: 20px;">
            <span class="qb-title-ink">Patients</span> Served Per Day
        </h2>

        <div class="qb-table-wrapper">
            <table class="qb-table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Patients Served</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ServedPerDay.Any())
                    {
                        @foreach (var day in Model.ServedPerDay)
                        {
                            <tr>
                                <td data-label="Date"><strong>@day.Date.ToString("ddd d MMM")</strong></td>
                                <td data-label="Served">@day.Count</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" style="text-align: center; color: var(--qc-slate); font-weight: 600; padding: 30px;">
                                No patients served in the last 7 days.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</section>