@model QueueCare.Models.BookAppointmentViewModel
@{
    ViewData["Title"] = "Book an appointment";
    var days = (List<QueueCare.Models.ClinicDay>)ViewBag.ClinicDays;
}

<div class="container py-4" style="max-width: 560px;">
    <h1 class="h3 mb-3">Book an appointment</h1>

    <form asp-action="Book" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="mb-3">
            <label asp-for="ClinicDayId" class="form-label"></label>
            <select asp-for="ClinicDayId" class="form-select">
                <option value="">-- choose a service and day --</option>
                @foreach (var d in days)
                {
                    <option value="@d.ClinicDayId" selected="@(d.ClinicDayId == Model.ClinicDayId)">
                        @d.Service.Name - @d.Date.ToString("ddd d MMM yyyy") (@d.OpenTime.ToString("HH:mm") to @d.CloseTime.ToString("HH:mm"))
                    </option>
                }
            </select>
            <span asp-validation-for="ClinicDayId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="SlotTime" class="form-label"></label>
            <input asp-for="SlotTime" type="time" step="900" class="form-control" />
            <span asp-validation-for="SlotTime" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Book appointment</button>
        <a asp-action="Mine" class="btn btn-link">My appointments</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}