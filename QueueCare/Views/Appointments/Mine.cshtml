@model List<QueueCare.Models.Appointment>
@{
    ViewData["Title"] = "My appointments";
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<section class="qb-section">
    <div class="qb-grid">

        <div class="qb-main">
            <h1 class="qb-title"><span class="qb-title-ink">My</span> Appointments</h1>

            @if (TempData["Message"] != null)
            {
                <div class="qb-alert-success">@TempData["Message"]</div>
            }

            @if (!Model.Any())
            {
                <p class="qb-empty">You have no appointments yet.</p>
                <div class="qb-actions" style="margin-top:20px;">
                    <a asp-action="Book" class="qb-btn qb-btn-confirm">Book a new appointment</a>
                </div>
            }
            else
            {
                <div class="qb-appt-list">
                    @foreach (var a in Model)
                    {
                        <div class="qb-appt-card">
                            <div class="qb-appt-info">
                                <strong>@a.ClinicDay.Service.Name</strong>
                                <span>@a.ClinicDay.Date.ToString("ddd d MMM yyyy") · @a.SlotTime.ToString("HH:mm")</span>
                            </div>
                            <div class="qb-appt-status">
                                <span class="qb-status qb-status-@a.Status.ToString().ToLower()">@a.Status</span>
                            </div>
                            <div class="qb-appt-actions">
                                @if (a.Status == QueueCare.Models.AppointmentStatus.Booked && a.ClinicDay.Date >= today)
                                {
                                    <form asp-action="Cancel" asp-route-id="@a.AppointmentId" method="post">
                                        <button type="submit" class="qb-btn-cancel-sm">Cancel</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="qb-actions" style="margin-top:24px;">
                    <a asp-action="Book" class="qb-btn qb-btn-confirm">Book a new appointment</a>
                </div>
            }
        </div>

        <aside class="qb-info">
            <div class="qb-info-image" aria-hidden="true">
                <svg viewBox="0 0 120 120" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="20" y="36" width="80" height="62" rx="8" />
                    <path d="M12 36l48-24 48 24" />
                    <path d="M60 52v28M46 66h28" />
                </svg>
            </div>
            <h2>Your visits</h2>
            <p>
                All your booked, served and cancelled visits in one place.
            </p>
            <ul>
                <li>Cancel at least a few hours before</li>
                <li>Bring your ID and clinic card</li>
                <li>Track your place from Live Queue</li>
            </ul>
        </aside>

    </div>
</section>