@model IEnumerable<Service>
@{
    ViewData["Title"] = "Manage services";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Manage services</h1>
    <a asp-action="Create" class="btn btn-primary">Add service</a>
</div>

@if (TempData["Message"] is string message)
{
    <div class="alert alert-success" role="alert">@message</div>
}

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Name</th>
            <th>Ticket code</th>
            <th>Average consultation (minutes)</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="5" class="text-muted">There are no services yet. Click "Add service" to create one.</td>
            </tr>
        }
        @foreach (Service s in Model)
        {
            <tr>
                <td>@s.Name</td>
                <td>@s.Code</td>
                <td>@s.AvgConsultMinutes</td>
                <td>
                    @if (s.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Deactivated</span>
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@s.ServiceId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    @if (s.IsActive)
                    {
                        <form asp-action="Deactivate" asp-route-id="@s.ServiceId" method="post" class="d-inline"
                              onsubmit="return confirm('Deactivate this service? Patients will no longer be able to book it.');">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                        </form>
                    }
                    else
                    {
                        <form asp-action="Activate" asp-route-id="@s.ServiceId" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
