@model QueueCare.Models.StaffResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="qb-section">
    <div class="qb-main" style="max-width: 600px; margin: 0 auto;">
        <h1 class="qb-title"><span class="qb-title-ink">Reset</span> Password</h1>
        <p class="qb-hint" style="margin-bottom: 20px;">Account: @Model.Email</p>

        <form asp-action="ResetPassword" method="post">
            <div asp-validation-summary="ModelOnly" class="qb-alert-error"></div>
            <input type="hidden" asp-for="Id" />

            <div class="qb-field">
                <label asp-for="NewPassword" class="qb-label">New password</label>
                <input asp-for="NewPassword" class="qb-input" autocomplete="new-password" />
                <span asp-validation-for="NewPassword"></span>
            </div>

            <button type="submit" class="qb-btn qb-btn-confirm">Reset password</button>
            <a asp-action="Index" style="display: inline-block; margin-top: 12px;">Cancel</a>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}